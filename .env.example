# WayFair Environment Variables

# API Configuration
REACT_APP_API_URL=https://api.wayfair.com/v1
REACT_APP_API_TIMEOUT=30000

# Blockchain
REACT_APP_NETWORK=mainnet
REACT_APP_INFURA_KEY=your_infura_key_here
REACT_APP_CONTRACT_ADDRESS=0x...
REACT_APP_WEB3_PROVIDER=https://mainnet.infura.io/v3/

# Payment Gateway
REACT_APP_STRIPE_KEY=pk_live_...
REACT_APP_STRIPE_SECRET=sk_live_...

# Firebase (for real-time features)
REACT_APP_FIREBASE_API_KEY=...
REACT_APP_FIREBASE_AUTH_DOMAIN=...
REACT_APP_FIREBASE_PROJECT_ID=...

# Storage
REACT_APP_STORAGE_URL=https://storage.wayfair.com
REACT_APP_STORAGE_BUCKET=wayfair-storage

# Features
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_LIVE_TRACKING=true
REACT_APP_ENABLE_BLOCKCHAIN=true
REACT_APP_ENABLE_PAYMENTS=true

# Environment
NODE_ENV=production
REACT_APP_DEBUG=false

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G_...
REACT_APP_SEGMENT_KEY=...

# Support
REACT_APP_SUPPORT_EMAIL=support@wayfair.com
REACT_APP_SUPPORT_PHONE=+1-800-WAYFAIR
